    <h2>Theme</h2>
    <label for="toggleTheme" class="control">
        <input type="checkbox" id="toggleTheme" class="toggle">
        Light theme
    </label>
    <script>
        (() => {
            const checkbox = document.querySelector('#toggleTheme');
            checkbox.addEventListener('change', e => {
                const newTheme = e.target.checked ? 'light' : 'dark';
                document.documentElement.dataset.theme = newTheme;
                window.localStorage.setItem('theme', newTheme)
            })
            checkbox.checked = window.localStorage.getItem('theme') == 'light'
        })()
    </script>

    <h2>Buttons</h2>

    <%
        const buttonSizes = ['small', 'default', 'medium', 'large']
        const buttonTypes = [
            { class: '', icon: 'add', label: 'Create' },
            { class: 'alt', icon: 'add', label: 'Add' },
            { class: 'secondary', icon: 'pause', label: 'Pause' },
            { class: 'success', icon: 'check', label: 'Confirm' },
            { class: 'danger', icon: 'delete', label: 'Delete' },
            { class: 'tertiary', icon: 'close', label: 'Close' },
            { class: 'text', icon: 'help', label: 'Need help?' },
            { class: 'text success', icon: 'favorite', label: 'Favorite' },
            { class: 'text danger', icon: 'flag', label: 'Report' },
            { class: 'text secondary', icon: 'close', label: 'Clear' },
            { class: 'outline', icon: 'help', label: 'Need help?' },
            { class: 'outline success', icon: 'check', label: 'Accept' },
            { class: 'outline danger', icon: 'error', label: 'Errors' },
            { class: 'outline secondary', icon: 'refresh', label: 'Refresh' },
            { class: 'outline tertiary', icon: 'close', label: 'Exit' },
        ]
    %>
    <div class="table-container">
        <table>
            <thead>
                <th></th>
                <% for( const size of buttonSizes ) { %>
                    <th class="text-center"><%= size %></th>
                <% } %>
            </thead>
            <tbody>
                <% for( const type of buttonTypes ) { %>
                    <tr>
                        <th scope="row"><%= type.class %></th>
                        <% for( const size of buttonSizes ) { %>
                            <td class="text-center">
                                <button class="btn <%= type.class %> <%= size %>">
                                    <div class="symbol filled"><%= type.icon %></div>
                                    <div class="label"><%= type.label %></div>
                                </button>
                            </td>
                        <% } %>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
