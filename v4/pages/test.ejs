    <script>
        document.querySelector('#showDropdown').addEventListener('click', async() => {
            const clicked = await showDropdown(document.querySelector('#showDropdown'), [
                { symbol: 'settings', label: 'Item 1' },
                { symbol: 'settings', label: 'Item 2', selected: true },
                { separator: true },
                { label: 'This option has a really long label to demonstrate overflow and other fun things', value: 'overflowTest' },
            ])
            console.log(clicked)
        })

        let dropdown2selection = 0;
        document.querySelector('#showDropdown2').addEventListener('click', async() => {
            const items = [];
            for (let i = 0; i < 100; i++) {
                items.push({ label: `Item ${i}`, value: i, selected: i == dropdown2selection })
            }
            const clicked = await showDropdown(document.querySelector('#showDropdown2'), items, {selectable: true}) ?? dropdown2selection
            dropdown2selection = clicked;
            console.log(clicked)
        })

        document.querySelector('#showDropdown3').addEventListener('click', async() => {
            const clicked = await showDropdown(null, [
